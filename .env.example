# ------------------------------------------------------------------------------
# OPTION 3: Gmail SMTP (Direct Google Mail)
# 1. Enable 2-Step Verification on your Google Account (ranesuyash2004@gmail.com)
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail" (16 letters, e.g. abcd efgh ijkl mnop)
# ------------------------------------------------------------------------------
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=ranesuyash2004@gmail.com
# SMTP_PASSWORD=your_16_character_app_password_here
